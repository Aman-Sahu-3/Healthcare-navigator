# Copy to .env and fill in. Never commit .env.

# --- App ---
ENVIRONMENT=local            # local | test | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- LLM ---
# Option A - OpenAI (paid):
OPENAI_API_KEY=sk-...
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini        # any OpenAI chat model; gpt-3.5-turbo also works
# Option B - Groq (free tier): key from console.groq.com
# OPENAI_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=700

# --- Embeddings & vector store ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_THREADS=           # empty = all cores; 1 on tiny hosts
EMBEDDING_BATCH_SIZE=32
CHROMA_COLLECTION=clinical_docs

# --- Ingestion ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=80           # drop tiny fragments like stray headers

# --- Retrieval & confidence ---
RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.35
HIGH_CONF_THRESHOLD=0.75
MEDIUM_CONF_THRESHOLD=0.60

# --- Security ---
ADMIN_API_KEY=change-me      # required for POST /ingest and /ingest/upload (X-API-Key header)
RATE_LIMIT=20/minute         # per client IP on POST /query
TRUST_PROXY_HEADERS=false    # true when deployed behind a proxy (Render, nginx)
MAX_UPLOAD_MB=25

# --- Deployment ---
AUTO_INGEST_ON_STARTUP=false  # index data/raw in the background when the index is empty
INDEX_URL=                    # download a prebuilt index at startup if none exists
INDEX_SHA256=                 # printed by: python -m app.ingestion --export
DOCS_ENABLED=                 # true/false; default: off only in production
CORS_ORIGIN_REGEX=            # e.g. https://healthcare-navigator.*\.vercel\.app

# --- Answer cache (repeated questions skip retrieval + LLM) ---
ANSWER_CACHE_SIZE=256        # 0 disables
ANSWER_CACHE_TTL_S=3600

# --- Optional LLM tracing (LangSmith) ---
# Sends questions and retrieved passages to LangSmith: only enable with data you may share.
# These are read by LangChain from the process environment (set them on Render, or in your shell).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=healthcare-navigator
